# Server port (defaults to 8000 in app.js)
PORT=8000

# PostgreSQL connection string
# Local Docker:  postgresql://terranthro_user:terranthro_pass@localhost:5432/terranthro
# Neon:          postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/terranthro?sslmode=require
DATABASE_URL=postgresql://terranthro_user:terranthro_pass@localhost:5432/terranthro

# Object storage (S3 or DigitalOcean Spaces) for COG raster files
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=terranthro-data
AWS_REGION=us-west-2

# Redis (optional — for caching)
REDIS_URL=redis://localhost:6379

NODE_ENV=development
